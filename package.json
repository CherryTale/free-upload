{
  "name": "free-upload",
  "displayName": "LazPay Efficient Tools",
  "icon": "images/upload_icon.jpg",
  "description": "An upload server.",
  "version": "0.0.18",
  "publisher": "zhuhaoran",
  "private": true,
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "free-upload.uploadStart",
        "title": "upload start"
      },
      {
        "command": "free-upload.uploadStop",
        "title": "upload stop"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Upload Configuration",
      "properties": {
        "free-upload.uploadFolder": {
          "type": "string",
          "default": "",
          "description": "The folder where uploaded files will be stored."
        },
        "free-upload.authToken": {
          "type": "string",
          "default": "",
          "description": "Token for the public server."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "watch": "webpack --mode development --watch",
    "vscode:prepublish": "npm run package",
    "package": "webpack --mode production --devtool hidden-source-map && mkdir -p ./dist/fe && cp -r ./apps/web/.next ./dist/fe",
    "dev": "pnpm --filter @free-upload/server dev & pnpm --filter @free-upload/web dev",
    "start": "pnpm --filter @free-upload/server start"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "bufferutil": "^4.0.8",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.13",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "utf-8-validate": "^6.0.3",
    "webpack": "^5.98.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.4.1",
    "crypto-js": "^4.2.0",
    "express": "^4.21.0",
    "multer": "1.4.5-lts.1",
    "next": "^14.2.15",
    "qrcode-terminal": "0.12.0",
    "socket.io": "4.7.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CherryTale/free-upload"
  }
}
